# Natural Power backend: plantilla de configuración.
# NO pongas valores reales aquí. Genera tu .env con:  npm run env:init
# (reemplaza cada CHANGE_ME por un valor aleatorio). El archivo .env no se sube a Git.

# --- Tokens de arranque: identifican a cada servicio ante el gestor de secretos ---
SM_TOKEN_API_GATEWAY=CHANGE_ME
SM_TOKEN_AUTH=CHANGE_ME
SM_TOKEN_CLIENTS=CHANGE_ME
SM_TOKEN_INVENTORY=CHANGE_ME
SM_TOKEN_ORDERS=CHANGE_ME
SM_TOKEN_PAYMENTS=CHANGE_ME
SM_TOKEN_GRAPHQL_GATEWAY=CHANGE_ME
SM_TOKEN_PROVIDER_MOCK=CHANGE_ME

# --- Secretos (solo los lee el gestor de secretos; los demás los piden por referencia) ---
SECRET_JWT_ACCESS=CHANGE_ME
SECRET_SVC_AUTH=CHANGE_ME
SECRET_SVC_CLIENTS=CHANGE_ME
SECRET_SVC_INVENTORY=CHANGE_ME
SECRET_SVC_ORDERS=CHANGE_ME
SECRET_SVC_PAYMENTS=CHANGE_ME
SECRET_SVC_GRAPHQL_GATEWAY=CHANGE_ME
SECRET_PAYMENT_WEBHOOK_HMAC=CHANGE_ME
SECRET_PROVIDER_API_KEY=CHANGE_ME
# Rotación: deja el valor nuevo en SECRET_X y el anterior en SECRET_X__PREVIOUS hasta retirarlo.

# --- Usuarios de prueba (se crean al arrancar con estas contraseñas; solo desarrollo) ---
SEED_ON_BOOT=true
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_CUSTOMER_PASSWORD=CHANGE_ME

# --- Configuración general ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
PUBLIC_PROVIDER_URL=http://localhost:4007
RATE_LIMIT_ANON=120
RATE_LIMIT_USER=240
RATE_LIMIT_AUTH=60
RATE_LIMIT_IP=1200
ACCESS_TOKEN_TTL_SECONDS=900
ORDER_TTL_MINUTES=15
DELIVERY_FEE=2500
FREE_DELIVERY_FROM=15000
GRAPHQL_MAX_DEPTH=7
GRAPHQL_MAX_COST=2000
GRAPHQL_INTROSPECTION=false
